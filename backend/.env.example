# Rag Innovations Backend Environment Variables (TEMPLATE ONLY - DO NOT PUT REAL KEYS HERE)
MISTRAL_API_KEY=your_mistral_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# LLM Model Configuration
LLM_MODEL=openai/gpt-oss-20b

# Chroma Vector Store Path
CHROMA_PERSIST_DIR=RagInno_DB

# CORS Allowed Origins (comma separated - add your Vercel URL in production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Server settings
HOST=0.0.0.0
PORT=8000
